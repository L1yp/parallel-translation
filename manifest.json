{
  "manifest_version": 3,
  "name": "对照式翻译",
  "version": "1.1.0",
  "description": "双语对照网页翻译：原文在上，译文在下，使用 Google 翻译接口。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://*.api.cognitive.microsofttranslator.com/*",
    "https://openapi.youdao.com/*",
    "https://m.youdao.com/*",
    "https://mobile.youdao.com/*",
    "https://transmart.qq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "对照式翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "切换整页翻译"
    }
  }
}
