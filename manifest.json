{
  "manifest_version": 3,
  "name": "沉浸式翻译 Lite",
  "version": "1.0.0",
  "description": "双语对照网页翻译：原文在上，译文在下，使用 Google 翻译接口。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "沉浸式翻译 Lite"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
